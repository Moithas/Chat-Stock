# Black Ledger — environment configuration
# Copy this file to ".env" and fill in your values. Never commit your real .env.

# ─── Required ───────────────────────────────────────────────────────────────
# Your bot token from the Discord Developer Portal (Bot → Reset Token).
# Keep this secret. Anyone with this token has full control of your bot.
DISCORD_TOKEN=your-bot-token-here

# ─── Optional ───────────────────────────────────────────────────────────────
# ONE-TIME MIGRATION (existing installs only): when upgrading a database that
# was created before per-server stock-market isolation, set this to the Discord
# server (guild) ID that owns the existing market data. On first startup the bot
# stamps all existing users/stocks/transactions/price history with this guild,
# then this variable can be removed. If your database already has data and this
# is unset, the bot will refuse to start (to avoid orphaning data). Fresh installs
# can leave it blank.
# LEGACY_GUILD_ID=

# Override the SQLite database file path (defaults to ./chatstock.db).
# DB_PATH=./chatstock.db

# Port for the local health-check HTTP endpoint (GET /health). Default: 8080.
# Only bound to 127.0.0.1 for use by process managers / uptime checks.
HEALTH_PORT=8080

# Set to "true" to include stack traces in error logs. Default: off.
DEBUG=false

# Optional off-host backup. If set, this shell command runs after every local
# database backup so backups can be copied to remote storage (protects against
# disk failure). Examples:
#   BACKUP_SYNC_CMD=rclone copy ./backups remote:black-ledger-backups
#   BACKUP_SYNC_CMD=aws s3 sync ./backups s3://your-bucket/black-ledger
# BACKUP_SYNC_CMD=

# ─── Legacy single-guild options (optional) ─────────────────────────────────
# These configure the market ticker / dashboard channels globally and only
# apply to a single server. For multi-server use, configure the ticker and
# dashboard channels per-guild via the /admin panel instead.
# TICKER_CHANNEL_ID=
# DASHBOARD_CHANNEL_ID=
